GATEWAY_ORIGIN_URL=http://localhost:9000
GATEWAY_SITE_ID=local
# Optional development bypass; leave empty for the normal challenge flow.
GATEWAY_DEV_ACCESS_TOKEN=
# Set a random secret for stable sessions; otherwise generated at startup.
GATEWAY_TOKEN_SECRET=replace-with-a-random-secret
GATEWAY_COOKIE_SECURE=false
GATEWAY_TIMEOUT_SECONDS=10

# Same random secret on gateway and protected origin; never expose to browsers.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_ORIGIN_SECRET=

# Optional Milestone 7 dashboard integration. Start the dashboard and add this
# site's ID first. Use an absolute path to Stopin-Dashboard/data/stopin.db.
GATEWAY_DASHBOARD_DB=

# Production profile: explicit secrets, Redis, persisted DB and exact hostnames.
GATEWAY_ENV=development
GATEWAY_REDIS_URL=
GATEWAY_ALLOWED_HOSTS=
GATEWAY_METRICS_TOKEN=
GATEWAY_TOKEN_PREVIOUS_SECRETS=[]
GATEWAY_RATE_LIMIT=120
GATEWAY_CHALLENGE_RATE_LIMIT=20
GATEWAY_MAX_BODY_BYTES=1048576
# Enable only on Railway HTTP ingress; private project peers must be trusted.
GATEWAY_TRUST_RAILWAY_PROXY=false
# Container bootstrap uses these alongside SITE_ID and ORIGIN_URL.
GATEWAY_DOMAIN=
WEB_CONCURRENCY=2
